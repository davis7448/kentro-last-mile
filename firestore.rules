rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isSeller(sellerId) {
      return role() == "seller" && request.auth.token.sellerId == sellerId;
    }

    function isSellerLogistics(sellerId) {
      return role() == "seller_logistics" && request.auth.token.sellerId == sellerId;
    }

    // Lectura operativa de la tienda: vendedor o logistico de la misma tienda.
    function isStoreMember(sellerId) {
      return isSeller(sellerId) || isSellerLogistics(sellerId);
    }

    function isDriver(driverId) {
      return role() == "driver" && request.auth.token.driverId == driverId;
    }

    // Lider de COMUNIDAD. Nada que ver con isDriver, que es el lider LOGISTICO.
    function isCommunityLeader(communityId) {
      return role() == "community_leader" && request.auth.token.communityId == communityId;
    }

    // Una tienda es de la comunidad del lider que consulta.
    function sellerInMyCommunity(sellerId) {
      return role() == "community_leader"
        && exists(/databases/$(database)/documents/sellers/$(sellerId))
        && get(/databases/$(database)/documents/sellers/$(sellerId)).data.communityId == request.auth.token.communityId;
    }

    function isMessenger(messengerId) {
      return role() == "messenger" && request.auth.token.messengerId == messengerId;
    }

    function messengerBelongsToDriver(messengerId) {
      return role() == "driver"
        && messengerId is string
        && exists(/databases/$(database)/documents/messengers/$(messengerId))
        && get(/databases/$(database)/documents/messengers/$(messengerId)).data.leaderDriverId == request.auth.token.driverId;
    }

    // Solo cambia campos de impresion de rotulo (inofensivo para el ciclo de vida del pedido).
    function labelOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "labelPrintedAt",
        "labelPrintedBy",
        "labelPrintCount",
        "updatedAt"
      ]);
    }

    function sellerOrderCreate() {
      return isStoreMember(request.resource.data.sellerId)
        && request.resource.data.driverId == null
        && request.resource.data.status in ["ready_to_assign", "address_risk"]
        && request.resource.data.evidence.size() == 0;
    }

    function sellerOrderNoopUpdate() {
      return isSeller(resource.data.sellerId)
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([]);
    }

    function operationalOrderUpdateByAssignee() {
      return (
          isDriver(resource.data.driverId)
          || isMessenger(resource.data.messengerId)
        )
        && resource.data.status in ["assigned", "call_pending", "scheduled", "picked_up", "in_route", "retry_pending"]
        && request.resource.data.status in ["call_pending", "scheduled", "picked_up", "in_route", "retry_pending"]
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.messengerId == resource.data.messengerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.evidence == resource.data.evidence
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "callOutcome",
          "callNote",
          "scheduledDate",
          "scheduledWindow",
          "rescheduledDate",
          "rescheduledWindow",
          "updatedAt"
        ]);
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /zones/{zoneId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /sellers/{sellerId} {
      // El lider de comunidad ve la ficha operativa de SUS tiendas. El saldo, la deuda y el
      // recaudo no viven aqui: estan en walletEntries y settlements, que tiene cerrados.
      allow read: if isAdmin() || isStoreMember(sellerId) || sellerInMyCommunity(sellerId);
      // Ni la tienda ni su lider cambian de comunidad por su cuenta (RF_11).
      allow write: if isAdmin();
    }

    match /communities/{communityId} {
      // Su lider la lee entera. Ninguna otra comunidad, ni siquiera de forma agregada (RF_52).
      allow read: if isAdmin() || isCommunityLeader(communityId);
      // Precios, marca y estado pasan SIEMPRE por callable: aqui no se escribe nunca.
      allow write: if false;

      match /priceHistory/{entryId} {
        allow read: if isAdmin() || isCommunityLeader(communityId);
        allow write: if false;
      }
    }

    match /communitySlugs/{slug} {
      // La resolucion del enlace publico la hace una callable sin sesion, con el SDK admin.
      allow read, write: if false;
    }

    match /drivers/{driverId} {
      allow read: if isAdmin() || isDriver(driverId);
      allow write: if isAdmin();
    }

    match /messengers/{messengerId} {
      allow read: if isAdmin()
        || isMessenger(messengerId)
        || (role() == "driver" && resource.data.leaderDriverId == request.auth.token.driverId);
      allow create: if isAdmin()
        || (role() == "driver" && request.resource.data.leaderDriverId == request.auth.token.driverId);
      allow update: if isAdmin()
        || (
          role() == "driver"
          && resource.data.leaderDriverId == request.auth.token.driverId
          && request.resource.data.leaderDriverId == resource.data.leaderDriverId
        );
      allow delete: if isAdmin();
    }

    match /pickupBatches/{batchId} {
      allow read: if isAdmin()
        || (role() == "driver" && resource.data.driverId == request.auth.token.driverId);
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || isStoreMember(resource.data.sellerId)
        || isDriver(resource.data.driverId)
        || isMessenger(resource.data.messengerId)
        || messengerBelongsToDriver(resource.data.messengerId)
        || (role() == "driver" && resource.data.driverId == null && resource.data.status == "ready_to_assign");
      // OJO: el lider de comunidad NO aparece aqui, y es deliberado. RF_31 le prohibe el
      // detalle de un pedido y los datos del cliente final; sus cifras salen agregadas del
      // servidor (getCommunityStats), sin que el navegador baje ni un pedido.
      allow create: if isAdmin() || sellerOrderCreate();
      // El ciclo de vida de los pedidos (status/driverId/evidence/etc.) se modifica SOLO por el
      // servidor via callables (admin SDK, que ignoran estas reglas, auditan y validan la
      // transicion). Desde el cliente solo se permite: imprimir rotulos (admin o miembro de la
      // tienda) y no-ops. Asi ningun navegador con estado viejo en cache puede "pisar" un pedido.
      allow update: if
        ((isAdmin() || isStoreMember(resource.data.sellerId)) && labelOnlyUpdate())
        || operationalOrderUpdateByAssignee()
        || sellerOrderNoopUpdate();
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if isAdmin() || isStoreMember(resource.data.sellerId);
      allow write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /productCatalog/{productId} {
      allow read: if isAdmin() || isStoreMember(resource.data.sellerId);
      allow write: if isAdmin();
    }

    match /walletEntries/{entryId} {
      allow read: if isAdmin()
        || (resource.data.ownerType == "seller" && isSeller(resource.data.ownerId))
        || (resource.data.ownerType == "driver" && isDriver(resource.data.ownerId))
        // Su PROPIO cashback si; el saldo de sus tiendas no. RF_31 prohibe lo de las tiendas,
        // no lo suyo: sin esto el lider no podria ver lo que se le debe.
        || (resource.data.ownerType == "community_leader" && isCommunityLeader(resource.data.ownerId));
      allow write: if isAdmin();
    }

    match /settlements/{settlementId} {
      allow read: if isAdmin()
        || (resource.data.kind == "seller" && isSeller(resource.data.ownerId))
        || (resource.data.kind == "driver" && isDriver(resource.data.ownerId))
        || (resource.data.kind == "community_leader" && isCommunityLeader(resource.data.ownerId));
      allow write: if isAdmin();
    }

    // Solicitudes de liquidacion. El vendedor YA NO crea el documento: el monto es una cifra
    // financiera derivada de walletEntries y las reglas no pueden validarla, asi que un create
    // desde el cliente permitia pedir cualquier cantidad. Se crean por el callable
    // requestSellerPayout (Admin SDK, no pasa por reglas). La tienda solo lee las suyas.
    match /payouts/{payoutId} {
      allow read: if isAdmin() || isSeller(resource.data.sellerId);
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Cuadre de caja: saldo real de las cuentas de la operacion, para contrastarlo
    // contra el saldo teorico. Solo el admin lo ve y lo registra; nunca se edita ni
    // se borra, para que el historico de desfases sea confiable.
    match /cashSnapshots/{snapshotId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /shopifyStores/{storeId} {
      allow read: if isAdmin() || isStoreMember(resource.data.sellerId);
      allow write: if isAdmin();
    }

    match /storeWebhookConfigs/{configId} {
      allow read: if isAdmin() || isStoreMember(resource.data.sellerId);
      allow write: if isAdmin();
    }

    // Tokens de API de ChatBy/UChat: nunca legibles/escribibles por cliente.
    // Solo las Cloud Functions (admin SDK) los usan.
    match /storeUchatSecrets/{sellerId} {
      allow read, write: if false;
    }

    // API keys de la API de solo lectura para tiendas (storeApi): nunca accesibles
    // por cliente; se generan/consultan via callable createStoreApiKey.
    match /storeApiConfigs/{sellerId} {
      allow read, write: if false;
    }

    match /storeWebhookSamples/{sampleId} {
      allow read: if isAdmin() || isStoreMember(resource.data.sellerId);
      allow write: if false;
    }

    match /shopifyInstallRequests/{requestId} {
      allow read: if isAdmin() || isStoreMember(resource.data.sellerId);
      allow create: if isSeller(request.resource.data.sellerId)
        && request.resource.data.status == "requested"
        && !("installLink" in request.resource.data);
      allow update: if isAdmin()
        || (
          isSeller(resource.data.sellerId)
          && resource.data.status == "requested"
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status == "requested"
          && !("installLink" in request.resource.data)
        );
      allow delete: if isAdmin();
    }

    match /shopifySyncIssues/{issueId} {
      allow read: if isAdmin() || isStoreMember(resource.data.sellerId);
      allow write: if false;
    }

    match /shopifyStoreSecrets/{storeId} {
      allow read, write: if false;
    }

    match /shopifyOAuthStates/{stateId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
